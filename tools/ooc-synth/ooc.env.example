# Copy to ooc.env (git-ignored) and fill in. Nothing here is a default path.
export CHIPYARD_ROOT=            # repo root
export OOC_WORK=                 # all outputs (large; put on a scratch disk)
export VIVADO_BIN=               # vivado executable
export FIRTOOL_BIN=              # firtool executable
export XILINX_PART=xcu250-figd2104-2L-e
export OOC_MAX_JOBS=4   # owner cap: never more than 4 Vivado jobs at once, host-wide
export OOC_CLOCK_NS=10
