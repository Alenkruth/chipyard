# rung_cfgs.env -- the defense-rung OOC ids: MIN-S-M-L-MAX, no IFT, no reconf outside Ceviche (owner 2026-11-11; plan claude-artifacts/ooc-synthesis/plans/defense-rung-plan.md, sections 2 and 4).
#
# Used by pilot.sh like defscale_cfgs.env:
#   export CAL_FILE=<this file> CAL_W_BASE=/data/akrish/scratch/defense-rung
#   CAL_ID=<id> pilot.sh <step>        W=$CAL_W_BASE/<id>
# Row format: <id> <CONFIG> <PT_PARAMS>.  PT_PARAMS=fir: tile RTL is cut from the elaborated FIRRTL; POINT is $W/ooc/points/Tile/fir/<CONFIG>.
# Ids: N + rung (I = MIN, S = Small, M = Medium, L = Mega, X = MAX) + suffix (0 base, T STT, D STT+Doppelganger, A SpecASan, C Ceviche+Reconf).
# NIC uses the MIN string with ic_ways=2;dc_ways=2 (own size block, MinCevBoomNoIFTStaticDMIConfig). The C cells need the C1 diff (N1.r1) to elaborate without IFT.
# No simulation is run for these ids, so the sim-only fields are harmless placeholders copied from defscale_cfgs.env: CAL_ELF, CAL_TRACE_ARGS,
# CAL_S1_MAXC and every RCSR_<id>. They exist only because pilot.sh `check` runs the S0/S1/S2 checks and chk_rcsr marks a fir id with no RCSR as FAIL.
# Nothing here is executed; pilot.sh reads it with awk/sed (rows need exactly 3 fields).
CAL_ELF=/data/akrish/scratch/power-pilot/sw/dhrystone1500.riscv
CAL_TRACE_ARGS=--trace-max-array 1024
CAL_S1_MAXC=16000000
CAL_W_BASE=/data/akrish/scratch/defense-rung
NI0   MinBoomNoIFTScaleBaseConfig          fir
NIT   MinBoomNoIFTScaleSTTConfig           fir
NID   MinBoomNoIFTScaleDGLConfig           fir
NIA   MinBoomNoIFTScaleSAConfig            fir
NIC   MinBoomNoIFTScaleCevConfig           fir
NS0   SmallBoomNoIFTScaleBaseConfig        fir
NST   SmallBoomNoIFTScaleSTTConfig         fir
NSD   SmallBoomNoIFTScaleDGLConfig         fir
NSA   SmallBoomNoIFTScaleSAConfig          fir
NSC   SmallBoomNoIFTScaleCevConfig         fir
NM0   MediumBoomNoIFTScaleBaseConfig       fir
NMT   MediumBoomNoIFTScaleSTTConfig        fir
NMD   MediumBoomNoIFTScaleDGLConfig        fir
NMA   MediumBoomNoIFTScaleSAConfig         fir
NMC   MediumBoomNoIFTScaleCevConfig        fir
NL0   MegaBoomNoIFTScaleBaseConfig         fir
NLT   MegaBoomNoIFTScaleSTTConfig          fir
NLD   MegaBoomNoIFTScaleDGLConfig          fir
NLA   MegaBoomNoIFTScaleSAConfig           fir
NLC   MegaBoomNoIFTScaleCevConfig          fir
NX0   MaxBoomNoIFTScaleBaseConfig          fir
NXT   MaxBoomNoIFTScaleSTTConfig           fir
NXD   MaxBoomNoIFTScaleDGLConfig           fir
NXA   MaxBoomNoIFTScaleSAConfig            fir
NXC   MaxBoomNoIFTScaleCevConfig           fir
RCSR_NI0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NIT=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NID=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NIA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NIC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NS0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NST=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NSD=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NSA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NSC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NM0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NMT=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NMD=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NMA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NMC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NL0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NLT=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NLD=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NLA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NLC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NX0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NXT=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NXD=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NXA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NXC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
NV0   MinV2BoomNoIFTScaleBaseConfig        fir
NVT   MinV2BoomNoIFTScaleSTTConfig         fir
NVD   MinV2BoomNoIFTScaleDGLConfig         fir
NVA   MinV2BoomNoIFTScaleSAConfig          fir
NVC   MinV2Cev1wBoomNoIFTScaleCevConfig        fir
RCSR_NV0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NVT=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NVD=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NVA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_NVC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
