# cal_cfgs.env -- the 5 power-calibration configs (plan claude-artifacts/ooc-synthesis/plans/power-calibration-plan.md, 1.2 and 2.2).
#
# Used by pilot.sh when CAL_ID is set:   CAL_ID=W2 pilot.sh <step>     (ids: W4 W2 W1 MIN4 HELD2)
# For the chosen id pilot.sh takes (each only when the variable is not already set in the environment):
#   CONFIG     sim config class (BaselineBoomPowerCal<X>DMIConfig, staged diff E5)
#   PT_PARAMS  OOC point knob string for `elaborate.sh Tile base`
#   W          work dir /data/akrish/scratch/power-cal/<id>
#   ELF        the pilot's dhrystone1500.riscv (workload is DHRYSTONE ONLY, owner decision, RULES C "Power calibration decisions")
#   TRACE_ARGS "--trace-max-array 256" (register-file arrays in the dump; appended to EXTRA_SIM_SOURCES in B1)
#   S1_MAXC    16000000 (small/narrow tiles run dhrystone slower)
# Format: one line per id, three whitespace-separated fields:  <id> <CONFIG> <PT_PARAMS>   ('#' lines and blanks ignored).
# PT_PARAMS must contain no spaces. K = the Baseline full-size knob list (pilot.sh default).
# Nothing here is executed; pilot.sh reads it with awk.
CAL_ELF=/data/akrish/scratch/power-pilot/sw/dhrystone1500.riscv
CAL_TRACE_ARGS=--trace-max-array 256
CAL_S1_MAXC=16000000
CAL_W_BASE=/data/akrish/scratch/power-cal
W4    BaselineBoomPowerCalW4DMIConfig    rob=256,fb=64,ftq=32,ras=32,iprf=192,fprf=96,iq_int=32,iq_mem=32,iq_fp=32,ldq=40,stq=40,btb_sets=128,btb_ways=2,tage=7,ic_sets=64,ic_ways=8,dc_sets=128,dc_ways=8,width=4
W2    BaselineBoomPowerCalW2DMIConfig    rob=256,fb=64,ftq=32,ras=32,iprf=192,fprf=96,iq_int=32,iq_mem=32,iq_fp=32,ldq=40,stq=40,btb_sets=128,btb_ways=2,tage=7,ic_sets=64,ic_ways=8,dc_sets=128,dc_ways=8,width=2
W1    BaselineBoomPowerCalW1DMIConfig    rob=256,fb=64,ftq=32,ras=32,iprf=192,fprf=96,iq_int=32,iq_mem=32,iq_fp=32,ldq=40,stq=40,btb_sets=128,btb_ways=2,tage=7,ic_sets=64,ic_ways=8,dc_sets=128,dc_ways=8,width=1
MIN4  BaselineBoomPowerCalMin4DMIConfig  rob=32,fb=16,ftq=8,ras=4,iprf=48,fprf=40,iq_int=8,iq_mem=8,iq_fp=8,ldq=8,stq=8,btb_sets=32,btb_ways=1,tage=1,ic_sets=8,ic_ways=1,dc_sets=16,dc_ways=1,width=4
HELD2 BaselineBoomPowerCalHeld2DMIConfig rob=128,fb=32,ftq=16,ras=16,iprf=96,fprf=48,iq_int=16,iq_mem=16,iq_fp=16,ldq=24,stq=24,btb_sets=64,btb_ways=2,tage=5,ic_sets=32,ic_ways=4,dc_sets=64,dc_ways=4,width=2
