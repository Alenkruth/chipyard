# defscale_cfgs.env -- the defense-scaling OOC ids (plan claude-artifacts/ooc-synthesis/plans/defense-scaling-ooc-plan.md, sections 1.2 and 4.1/4.2, E-P2).
#
# Used by pilot.sh like defpower_cfgs.env / cal_cfgs.env:
#   export CAL_FILE=<this file> CAL_W_BASE=/data/akrish/scratch/defense-scaling
#   CAL_ID=<id> pilot.sh <step>        W=$CAL_W_BASE/<id>
# Row format: <id> <CONFIG> <PT_PARAMS>.  PT_PARAMS=fir: tile RTL is cut from the elaborated FIRRTL ($GENSRC/<long>.fir, step B0/B1 then P1F);
# POINT is $W/ooc/points/Tile/fir/<CONFIG>.  CONFIG classes: E-S1 (BoomConfigs.scala; the X rows use the uncommented option-C classes).
# Ids: S = Small, M = Medium, G = Mega (stock sizes + IFT, NoLog), X = max core (CoreFuzzingDMIPowerConfig family; X0 = U and XA = A0 are
# reused from defpower_cfgs.env, not listed). Suffix: 0 base, T STT, D STT+Doppelganger, A SpecASan, R base+Reconf (Ceviche baseline), C Ceviche.
# NEEDS R1 (fetch-buffer pad / D$ victim select clamp diff; plan 1.2): SR SC MR MC. They do not elaborate on the Small/Medium FB/D$ sizes without it.
# No simulation is run for these ids, so the sim-only fields are harmless placeholders copied from defpower_cfgs.env: CAL_ELF, CAL_TRACE_ARGS,
# CAL_S1_MAXC and every RCSR_<id> (all point at the existing plru.rcsr). They exist only because pilot.sh `check` runs the S0/S1/S2 checks, and
# chk_rcsr (pilot.sh:153) marks a fir id with no RCSR as FAIL; nothing here is used by B0/P1F/P2/PK.
# Nothing here is executed; pilot.sh reads it with awk/sed (rows need exactly 3 fields).
CAL_ELF=/data/akrish/scratch/power-pilot/sw/dhrystone1500.riscv
CAL_TRACE_ARGS=--trace-max-array 1024
CAL_S1_MAXC=16000000
CAL_W_BASE=/data/akrish/scratch/defense-scaling
S0    SmallBoomScaleBaseConfig                     fir
ST    SmallBoomScaleSTTConfig                      fir
SD    SmallBoomScaleDGLConfig                      fir
SA    SmallBoomScaleSAConfig                       fir
# needs R1 (comment on its own line: a row must have exactly 3 fields)
SR    SmallBoomScaleReconfConfig                   fir
# needs R1 (comment on its own line: a row must have exactly 3 fields)
SC    SmallBoomScaleCevConfig                      fir
M0    MediumBoomScaleBaseConfig                    fir
MT    MediumBoomScaleSTTConfig                     fir
MD    MediumBoomScaleDGLConfig                     fir
MA    MediumBoomScaleSAConfig                      fir
# needs R1 (comment on its own line: a row must have exactly 3 fields)
MR    MediumBoomScaleReconfConfig                  fir
# needs R1 (comment on its own line: a row must have exactly 3 fields)
MC    MediumBoomScaleCevConfig                     fir
G0    MegaBoomScaleBaseConfig                      fir
GT    MegaBoomScaleSTTConfig                       fir
GD    MegaBoomScaleDGLConfig                       fir
GA    MegaBoomScaleSAConfig                        fir
GR    MegaBoomScaleReconfConfig                    fir
GC    MegaBoomScaleCevConfig                       fir
XST   CoreFuzzingDMISTTPowerConfig                 fir
XSD   CoreFuzzingDMISTTDoppelgangerPowerConfig     fir
XSA   CoreFuzzingDMISpecASanPowerConfig            fir
XSC   CoreFuzzingDMICevichePowerConfig             fir
RCSR_S0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_ST=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_SD=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_SA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_SR=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_SC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_M0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_MT=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_MD=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_MA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_MR=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_MC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_G0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_GT=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_GD=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_GA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_GR=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_GC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_XST=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_XSD=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_XSA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_XSC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
