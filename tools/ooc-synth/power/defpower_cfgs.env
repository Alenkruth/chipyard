# defpower_cfgs.env -- the defense power ids (plan claude-artifacts/ooc-synthesis/plans/defense-power-plan.md, option B, sections 1.2 and 3 E6).
#
# Used by pilot.sh / sim_lane.sh / post_lane.sh / prewin.sh like cal_cfgs.env:
#   export CAL_FILE=<this file> CAL_W_BASE=/data/akrish/scratch/defense-power   (the lanes read CAL_W_BASE from the env or from this file)
#   CAL_ID=<id> pilot.sh <step>        W=$CAL_W_BASE/<id>
# Row format (cal_cfgs.env): <id> <CONFIG> <PT_PARAMS>.  PT_PARAMS=fir marks a point whose tile RTL is cut from the sim build's own
# FIRRTL (pilot.sh step P1F) instead of elaborate.sh; its POINT is $W/ooc/points/Tile/fir/<CONFIG>.
# Lines NAME=value are read by pilot.sh (_cal_var):  RCSR_<id> = the +reconfig_csrs file of that id (appended after the ELF in S0/S1/S2).
# U = undefended core (own netlist).  A0 = undefended on the AllDef netlist (paper baseline); ASTT ADGL ASA ACEV AALL = one defense set per
# CSR file on the SAME AllDef sim binary and netlist: only A0 runs B1/P1F/P3/P2 (POINT_DIR=<A0 point> for post_lane of the others).
# ASTTF ADGLF = optional Futuristic variants.  Nothing here is executed; pilot.sh reads it with awk/sed.
CAL_ELF=/data/akrish/scratch/power-pilot/sw/dhrystone1500.riscv
CAL_TRACE_ARGS=--trace-max-array 1024
CAL_S1_MAXC=16000000
CAL_W_BASE=/data/akrish/scratch/defense-power
U     CoreFuzzingDMIPowerConfig       fir
A0    CoreFuzzingDMIAllDefPowerConfig fir
ASTT  CoreFuzzingDMIAllDefPowerConfig fir
ADGL  CoreFuzzingDMIAllDefPowerConfig fir
ASA   CoreFuzzingDMIAllDefPowerConfig fir
ACEV  CoreFuzzingDMIAllDefPowerConfig fir
AALL  CoreFuzzingDMIAllDefPowerConfig fir
ASTTF CoreFuzzingDMIAllDefPowerConfig fir
ADGLF CoreFuzzingDMIAllDefPowerConfig fir
RCSR_U=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_A0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_ASTT=/data/akrish/scratch/defense-power/rcsr/stt-s.rcsr
RCSR_ADGL=/data/akrish/scratch/defense-power/rcsr/stt-s-dgl.rcsr
RCSR_ASA=/data/akrish/scratch/defense-power/rcsr/sa.rcsr
RCSR_ACEV=/data/akrish/scratch/defense-power/rcsr/cev.rcsr
RCSR_AALL=/data/akrish/scratch/defense-power/rcsr/all4.rcsr
RCSR_ASTTF=/data/akrish/scratch/defense-power/rcsr/stt-f.rcsr
RCSR_ADGLF=/data/akrish/scratch/defense-power/rcsr/stt-f-dgl.rcsr
