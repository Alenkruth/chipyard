# specmatch_cfgs.env -- SPEC-matched paper configs S, M, L OOC ids (owner 2026-11-16 17:3x; staged/defense-specmatch/KNOBS.md). No IFT, no reconf outside Ceviche.
# S <- August ladder cfg01, M <- cfg07, L <- cfg17. MAX not rebuilt (reuse NX* in /data/akrish/scratch/defense-rung).
# Used by pilot.sh like rung_cfgs.env:  export CAL_FILE=<this file>   W=$CAL_W_BASE/<id>
# Row format: <id> <CONFIG> <PT_PARAMS>.  PT_PARAMS=fir.
# Ids: P + size (S, M, L) + suffix (0 base, T STT, D STT+Doppelganger, A SpecASan, C Ceviche+Reconf). PSC uses the 2-way I$/D$ S parent.
# Sim-only fields (CAL_ELF, CAL_TRACE_ARGS, CAL_S1_MAXC, RCSR_<id>) are placeholders copied from rung_cfgs.env (pilot.sh check needs them; no sim is run).
CAL_ELF=/data/akrish/scratch/power-pilot/sw/dhrystone1500.riscv
CAL_TRACE_ARGS=--trace-max-array 1024
CAL_S1_MAXC=16000000
CAL_W_BASE=/data/akrish/scratch/defense-specmatch
PS0   SpecMatchSBoomNoIFTScaleBaseConfig     fir
PST   SpecMatchSBoomNoIFTScaleSTTConfig      fir
PSD   SpecMatchSBoomNoIFTScaleDGLConfig      fir
PSA   SpecMatchSBoomNoIFTScaleSAConfig       fir
PSC   SpecMatchSBoomNoIFTScaleCevConfig      fir
PM0   SpecMatchMBoomNoIFTScaleBaseConfig     fir
PMT   SpecMatchMBoomNoIFTScaleSTTConfig      fir
PMD   SpecMatchMBoomNoIFTScaleDGLConfig      fir
PMA   SpecMatchMBoomNoIFTScaleSAConfig       fir
PMC   SpecMatchMBoomNoIFTScaleCevConfig      fir
PL0   SpecMatchLBoomNoIFTScaleBaseConfig     fir
PLT   SpecMatchLBoomNoIFTScaleSTTConfig      fir
PLD   SpecMatchLBoomNoIFTScaleDGLConfig      fir
PLA   SpecMatchLBoomNoIFTScaleSAConfig       fir
PLC   SpecMatchLBoomNoIFTScaleCevConfig      fir
RCSR_PS0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PST=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PSD=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PSA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PSC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PM0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PMT=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PMD=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PMA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PMC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PL0=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PLT=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PLD=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PLA=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
RCSR_PLC=/data/akrish/scratch/defense-power/rcsr/plru.rcsr
